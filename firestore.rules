rules_version = '2';

// LookMedia Africa reads and writes Firestore only from the server, using the Firebase
// Admin SDK (which bypasses these rules). The browser never talks to Firestore,
// so every client request is denied. Publish these rules as they are.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
